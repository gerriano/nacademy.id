---
import Base from '../layouts/Base.astro';
---
<Base title="Halaman tidak ditemukan">
  <section class="nf wrap">
    <span class="nf__dot" aria-hidden="true"></span>
    <p class="label">404</p>
    <h1 class="nf__title">Tarik napas dulu.</h1>
    <p class="lede">Halaman yang kamu cari tidak ada atau sudah dipindahkan.</p>
    <a class="btn" href="/">Kembali ke beranda <span class="arrow" aria-hidden="true">→</span></a>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    min-height: 80svh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 22px;
    padding-top: calc(120px + env(safe-area-inset-top, 0px));
    padding-bottom: 80px;
    overflow: hidden;
  }
  .nf__dot {
    position: absolute;
    right: -10vw;
    top: 50%;
    width: min(60vw, 560px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--lime);
    transform: translateY(-50%);
    z-index: -1;
    animation: breathe 14s ease-in-out infinite;
  }
  .nf__title { font-size: var(--t-1); letter-spacing: -0.05em; }
  @keyframes breathe { 0%, 100% { transform: translateY(-50%) scale(0.85); } 30%, 57% { transform: translateY(-50%) scale(1); } }
</style>
