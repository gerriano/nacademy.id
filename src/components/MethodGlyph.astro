---
/** Small abstract mark for each technique, drawn from the lime dot motif. */
interface Props { shape: string }
const { shape } = Astro.props;
---
<svg class="glyph" viewBox="0 0 80 80" aria-hidden="true">
  {shape === 'frame' && (<>
    <rect x="10" y="10" width="60" height="60" rx="4" fill="none" stroke="currentColor" stroke-width="2" />
    <rect x="22" y="22" width="36" height="36" rx="2" fill="none" stroke="currentColor" stroke-width="2" transform="rotate(12 40 40)" />
    <circle cx="40" cy="40" r="7" fill="var(--lime)" />
  </>)}
  {shape === 'home' && (<>
    <path d="M14 40 L40 16 L66 40 V66 H14 Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
    <circle cx="40" cy="48" r="10" fill="var(--lime)" />
  </>)}
  {shape === 'wave' && (<>
    <path d="M6 40 Q18 22 30 40 T54 40 T78 40" fill="none" stroke="currentColor" stroke-width="2" />
    <path d="M6 54 Q18 36 30 54 T54 54 T78 54" fill="none" stroke="currentColor" stroke-width="2" opacity="0.4" />
    <circle cx="30" cy="40" r="6" fill="var(--lime)" />
  </>)}
  {shape === 'bubble' && (<>
    <path d="M12 18 H68 V54 H34 L22 66 V54 H12 Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
    <circle cx="28" cy="36" r="4" fill="var(--lime)" /><circle cx="40" cy="36" r="4" fill="var(--lime)" /><circle cx="52" cy="36" r="4" fill="var(--lime)" />
  </>)}
  {shape === 'circle' && (<>
    <circle cx="40" cy="40" r="30" fill="none" stroke="currentColor" stroke-width="2" />
    <circle cx="40" cy="40" r="19" fill="none" stroke="currentColor" stroke-width="2" opacity="0.4" />
    <circle cx="40" cy="40" r="8" fill="var(--lime)" />
  </>)}
  {shape === 'grow' && (<>
    <path d="M12 66 H68" stroke="currentColor" stroke-width="2" />
    <rect x="16" y="50" width="10" height="16" fill="none" stroke="currentColor" stroke-width="2" />
    <rect x="35" y="36" width="10" height="30" fill="none" stroke="currentColor" stroke-width="2" />
    <rect x="54" y="20" width="10" height="46" fill="none" stroke="currentColor" stroke-width="2" />
    <circle cx="59" cy="12" r="6" fill="var(--lime)" />
  </>)}
  {shape === 'spark' && (<>
    <path d="M40 8 V30 M40 50 V72 M8 40 H30 M50 40 H72 M17 17 L32 32 M48 48 L63 63 M63 17 L48 32 M32 48 L17 63" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    <circle cx="40" cy="40" r="8" fill="var(--lime)" />
  </>)}
</svg>

<style>
  .glyph { width: 72px; height: 72px; overflow: visible; }
</style>
