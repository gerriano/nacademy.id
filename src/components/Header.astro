---
import Logo from './Logo.astro';
import { nav } from '../data/site';
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="hdr" data-header>
  <div class="wrap hdr__inner">
    <a href="/" class="hdr__brand" aria-label="Nacademy — Beranda"><Logo /></a>

    <nav class="hdr__nav" aria-label="Utama">
      {nav.slice(1).map((item) => (
        <a href={item.href} class:list={['hdr__link', { 'is-active': isActive(item.href) }]}
           aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="sr-only">Buka menu</span>
      <span class="hdr__bar"></span><span class="hdr__bar"></span>
    </button>
  </div>
</header>

<div class="menu" id="menu" data-menu hidden>
  <nav class="wrap menu__nav" aria-label="Menu">
    {nav.map((item) => (
      <a href={item.href} class="menu__link" data-menu-link>
        <span>{item.label}</span>
      </a>
    ))}
  </nav>
  <p class="wrap menu__foot label">Ruang belajar untuk hati yang lebih tenang</p>
</div>

<style>
  .hdr {
    position: fixed;
    top: env(safe-area-inset-top, 0px);
    left: 0;
    right: 0;
    z-index: 50;
    transition: transform 0.6s var(--ease);
  }
  .hdr.is-hidden { transform: translateY(-110%); }
  .hdr::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--glass);
    backdrop-filter: saturate(1.6) blur(18px);
    -webkit-backdrop-filter: saturate(1.6) blur(18px);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .hdr.is-scrolled::before { opacity: 1; }
  .hdr__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 64px;
  }
  .hdr__brand { text-decoration: none; padding-left: 0.2em; }
  .hdr__nav { display: flex; gap: clamp(16px, 2.4vw, 36px); }
  .hdr__link {
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.25s;
    position: relative;
  }
  .hdr__link:hover, .hdr__link.is-active { color: var(--ink); }
  .hdr__link.is-active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -10px;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--lime);
  }
  .hdr__burger {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
  }
  .hdr__bar {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.5s var(--ease);
  }
  .hdr__bar:nth-of-type(1) { top: 18px; }
  .hdr__bar:nth-of-type(2) { top: 25px; }
  .hdr__burger[aria-expanded='true'] .hdr__bar:nth-of-type(1) { transform: translateY(3.5px) rotate(45deg); }
  .hdr__burger[aria-expanded='true'] .hdr__bar:nth-of-type(2) { transform: translateY(-3.5px) rotate(-45deg); }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 45;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: calc(96px + env(safe-area-inset-top, 0px));
    padding-bottom: calc(32px + env(safe-area-inset-bottom, 0px));
  }
  .menu__nav { display: flex; flex-direction: column; gap: 4px; }
  .menu__link {
    display: block;
    overflow: hidden;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(2.4rem, 11vw, 4rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
    text-decoration: none;
  }
  .menu__link span { display: inline-block; }

  @media (max-width: 860px) {
    .hdr__nav { display: none; }
    .hdr__burger { display: block; }
  }
</style>
